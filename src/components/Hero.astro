---
interface Props {
  eyebrow?: string;
  title: string;
  titleAs?: 'h1' | 'h2';
  description: string;
}

const { eyebrow, title, titleAs = 'h1', description } = Astro.props;
const Heading = titleAs;
---

<section class="hero">
  <div class="container hero__grid">
    <div>
      {eyebrow && <p class="mono">{eyebrow}</p>}
      <Heading>{title}</Heading>
      <p class="lede">{description}</p>
      <div class="hero__actions">
        <slot name="actions" />
      </div>
    </div>
    <div class="hero__aside">
      <slot name="aside" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgb(124 58 237 / 0.08), transparent 58%);
  }

  .hero__grid {
    display: grid;
    gap: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  .hero__aside:empty {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.8fr);
      align-items: center;
    }
  }
</style>

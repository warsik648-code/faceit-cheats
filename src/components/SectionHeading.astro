---
interface Props {
  eyebrow?: string;
  title: string;
  titleAs?: 'h1' | 'h2' | 'h3';
  titleId?: string;
  description?: string;
}

const { eyebrow, title, titleAs = 'h2', titleId, description } = Astro.props;
const Heading = titleAs;
---

<header class="section-heading">
  {eyebrow && <p class="mono">{eyebrow}</p>}
  <Heading id={titleId}>{title}</Heading>
  {description && <p class="lede">{description}</p>}
</header>

<style>
  .section-heading {
    margin-bottom: 2rem;
    max-width: 42rem;
  }

  .section-heading :global(h1),
  .section-heading :global(h2),
  .section-heading :global(h3) {
    margin-bottom: 0.65rem;
  }
</style>

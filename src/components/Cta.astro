---
import { SITE } from '../data/site';
import { supportUrl, transactionUrl } from '../utils/urls';

interface Props {
  label: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  destination?: 'transaction' | 'support' | 'internal';
  href?: string;
  tracking?: Record<string, string>;
}

const {
  label,
  variant = 'primary',
  destination = 'internal',
  href,
  tracking,
} = Astro.props;

const resolvedHref =
  destination === 'transaction'
    ? transactionUrl(tracking)
    : destination === 'support'
      ? supportUrl(tracking)
      : href;

if (!resolvedHref) {
  throw new Error('Cta requires href when destination is internal.');
}

const isExternal = destination === 'transaction' || destination === 'support';
const rel = isExternal ? 'nofollow noopener noreferrer' : undefined;
const target = isExternal ? '_blank' : undefined;
---

<a
  class:list={['cta', `cta--${variant}`]}
  href={resolvedHref}
  rel={rel}
  target={target}
>
  <span>{label}</span>
  {
    destination === 'transaction' && (
      <span class="cta__hint">Opens {new URL(SITE.external.transactionUrl).host}</span>
    )
  }
</a>

<style>
  .cta {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.85rem 1.15rem;
    border-radius: 0.8rem;
    border: 1px solid transparent;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .cta--primary {
    background: linear-gradient(135deg, var(--accent-violet), #6d28d9 60%, #9d174d);
    color: #fff;
    box-shadow: 0 10px 30px rgb(124 58 237 / 0.22);
  }

  .cta--secondary {
    background: rgb(255 255 255 / 0.04);
    border-color: var(--border-strong);
    color: #fff;
  }

  .cta--ghost {
    padding-inline: 0.2rem;
    background: transparent;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cta__hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
    opacity: 0.8;
  }

  @media (hover: hover) {
    .cta--primary:hover,
    .cta--secondary:hover {
      transform: translateY(-1px);
    }

    .cta--secondary:hover {
      border-color: rgb(124 58 237 / 0.55);
    }
  }
</style>

---
import type { BreadcrumbItem } from '../utils/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;

        return (
          <li>
            {item.path && !isLast ? <a href={item.path}>{item.label}</a> : <span aria-current={isLast ? 'page' : undefined}>{item.label}</span>}
            {!isLast && <span class="sep" aria-hidden="true">/</span>}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding: 1.1rem 0 0;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  a:hover,
  [aria-current='page'] {
    color: #fff;
  }

  .sep {
    opacity: 0.45;
  }
</style>

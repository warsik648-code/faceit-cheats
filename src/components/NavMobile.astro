---
import { primaryNav } from '../data/navigation';
import { isActivePath, isBlogPath, isFaqPath, isHomePath, isInternalChromePath } from '../utils/urls';
import Cta from './Cta.astro';

const currentPath = Astro.url.pathname;
const onHome = isHomePath(currentPath);
const exploreHub = isFaqPath(currentPath) || isBlogPath(currentPath);
const internalChrome = isInternalChromePath(currentPath);
---

<details class="nav-mobile">
  <summary>
    <span class="visually-hidden">Menu</span>
    <span class="bars" aria-hidden="true"></span>
  </summary>
  <nav aria-label="Mobile">
    <ul>
      {
        primaryNav.map((item) => (
          <li>
            <a
              href={item.path}
              aria-current={isActivePath(currentPath, item.path) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    {
      internalChrome ? (
        <Cta
          label={onHome ? 'Explore CS2' : exploreHub ? 'Explore Games' : 'Open CS2 page'}
          href={exploreHub ? '/' : '/cs2/'}
        />
      ) : (
        <Cta label="Get access" destination="transaction" tracking={{ ref: 'mobile-nav' }} />
      )
    }
  </nav>
</details>

<style>
  .nav-mobile {
    position: relative;
  }

  summary {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.7rem;
    background: rgb(255 255 255 / 0.03);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: #fff;
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .bars::before {
    top: -5px;
  }

  .bars::after {
    top: 5px;
  }

  nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.65rem);
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.85rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--glass);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-soft);
  }

  ul {
    margin: 0 0 0.85rem;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 0.7rem 0.55rem;
    border-radius: 0.5rem;
    color: #fff;
    text-decoration: none;
  }

  a[aria-current='page'] {
    background: rgb(124 58 237 / 0.16);
  }

  @media (min-width: 1040px) {
    .nav-mobile {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    for (const menu of document.querySelectorAll('details.nav-mobile[open]')) {
      if (menu instanceof HTMLDetailsElement) {
        menu.open = false;
      }
    }
  });
</script>

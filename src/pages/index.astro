---
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import FeatureCard from '../components/FeatureCard.astro';
import GameCard from '../components/GameCard.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatusBoard from '../components/StatusBoard.astro';
import StatusIndicator from '../components/StatusIndicator.astro';
import { homepageFaqs } from '../data/faq';
import { featuredGame, games } from '../data/games';
import { homeHero, hubFeatures, providerPoints } from '../data/home';
import { pageSeo } from '../data/seo';
import { getStatus } from '../data/status';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqJsonLd } from '../utils/jsonld';

const cs2Status = getStatus(featuredGame.id);
const otherGames = games.filter((game) => !game.featured);
---

<BaseLayout seo={pageSeo.home} extraJsonLd={[faqJsonLd(homepageFaqs)]}>
  <Hero eyebrow={homeHero.eyebrow} title={homeHero.title} description={homeHero.description}>
    <Fragment slot="actions">
      <Cta label="Explore CS2" href="/cs2/" />
      <Cta label="Check Status" href="/status/" variant="secondary" />
    </Fragment>
    <aside slot="aside" class="hero-panel">
      <p class="mono">Primary offering</p>
      <p class="hero-panel__title">Counter-Strike 2</p>
      <p>
        CS2 FACEIT coverage lives on its own product page. This hub only points you there and
        repeats the configured label.
      </p>
      <StatusIndicator detectionState={cs2Status.detectionState} runState={cs2Status.runState} />
      <p class="hero-panel__links">
        <a href="/cs2/">Open the CS2 page</a>
        ·
        <a href="/status/">FACEIT status</a>
      </p>
    </aside>
  </Hero>

  <section class="section" aria-labelledby="what-are-faceit-cheats">
    <div class="container copy-block">
      <SectionHeading
        eyebrow="Platform vs games"
        title="What Are FACEIT Cheats?"
        titleId="what-are-faceit-cheats"
        description="FACEIT itself is not a game. A FACEIT cheat is software for a title you already play inside FACEIT’s competitive queues."
      />
      <p>
        Players search for a FACEIT hack or FACEIT hacks when they want private tools on that
        platform. faceitcheats.net answers by naming the FACEIT games first — Counter-Strike 2,
        Valorant, Overwatch 2, Rainbow Six Siege — then sending each visitor to a dedicated URL.
        We do not describe FACEIT’s internal security architecture here; this section only
        separates the platform from the games.
      </p>
      <p>
        If you already know you want CS2, skip ahead to
        <a href="/cs2/">the CS2 product page</a>.
        If you are still choosing, use the directory below, then
        <a href="/faq/">read the FAQ</a>
        or later
        <a href="/blog/">blog notes</a>.
      </p>
    </div>
  </section>

  <section class="section section--secondary" aria-labelledby="games-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Game directory"
        title="Choose the FACEIT game you play"
        titleId="games-heading"
        description="Each card is a unique route. CS2 is marked as the primary game; the others are ready for later product pages."
      />
      <div class="game-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="provider-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Why this hub"
        title="A Private FACEIT Cheat Provider Built Around Each Game"
        titleId="provider-heading"
        description="faceitcheats.net is built as a FACEIT cheat provider: private distribution, per-game pages, and a single status source — not one article pretending to cover every title."
      />
      <div class="feature-grid">
        {providerPoints.map((feature) => <FeatureCard feature={feature} />)}
      </div>
    </div>
  </section>

  <section class="section section--secondary" aria-labelledby="features-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Cross-game overview"
        title="Feature categories, documented per title"
        titleId="features-heading"
        description="This is a map, not a claim that every module exists on every game. Exact CS2 tools are listed on the CS2 feature block."
      />
      <div class="feature-grid">
        {hubFeatures.map((feature) => <FeatureCard feature={feature} />)}
      </div>
      <p class="board-link">
        <a href="/cs2/#cs2-features">See the CS2 feature breakdown</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="status-heading">
    <div class="container">
      <SectionHeading
        eyebrow="FACEIT status"
        title="Configured availability across every title"
        titleId="status-heading"
        description="Last detection tests, bans, ban waves, and safety percentages are kept on the status page. The board below is a live read of the same configuration: low ban-ratio positioning, treated as very safe, and kept up to date."
      />
      <StatusBoard showPlaceholders={false} showNotes={false} />
      <p class="board-link">
        <a href="/status/">Open the full FACEIT status page</a>
      </p>
    </div>
  </section>

  <section class="section section--secondary" aria-labelledby="cs2-featured-heading">
    <div class="container">
      <div class="featured-cs2">
        <SectionHeading
          eyebrow="Primary game"
          title="Looking for CS2 FACEIT Cheats?"
          titleId="cs2-featured-heading"
          description="CS2 has a dedicated commercial page. Use it for the feature breakdown, a status link, the showcase area, FAQs, and access information — this hub does not repeat that product copy."
        />
        <div class="cluster">
          <Cta label="Explore CS2" href="/cs2/" />
          <Cta label="CS2 feature list" href="/cs2/#cs2-features" variant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="discovery-heading">
    <div class="container">
      <SectionHeading
        eyebrow="More FACEIT games"
        title="Valorant, Overwatch 2, and Siege"
        titleId="discovery-heading"
        description="These routes exist now as dedicated shells. Later phases will write their product pages independently of CS2."
      />
      <div class="discover-grid">
        {
          otherGames.map((game) => (
            <article class="discover-card">
              <p class="mono">{game.shortName}</p>
              <h3>{game.name}</h3>
              <p>{game.hubDescription}</p>
              <a href={game.path}>{game.hubCta}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--secondary" aria-labelledby="faq-heading">
    <div class="container">
      <SectionHeading
        eyebrow="FAQ"
        title="FACEIT hub questions"
        titleId="faq-heading"
        description="Broad site questions stay here. CS2-specific product questions belong on the CS2 page."
      />
      <Faq items={homepageFaqs} />
      <p class="board-link">
        <a href="/faq/">See the full FAQ</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-panel {
    padding: 1.35rem 1.4rem 1.5rem;
    border: 1px solid rgb(124 58 237 / 0.28);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .hero-panel__title {
    margin: 0.45rem 0 0.6rem;
    color: #fff;
    font-size: 1.6rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .hero-panel__links,
  .board-link,
  .copy-block a,
  .discover-card a {
    color: #fff;
  }

  .hero-panel__links {
    margin-top: 0.85rem;
  }

  .copy-block {
    max-width: 46rem;
  }

  .copy-block :global(.section-heading) {
    margin-bottom: 1.1rem;
  }

  .game-grid,
  .feature-grid,
  .discover-grid {
    display: grid;
    gap: 1rem;
  }

  .board-link {
    margin-top: 1.25rem;
  }

  .featured-cs2 {
    padding: 1.6rem 1.4rem 1.7rem;
    border: 1px solid rgb(124 58 237 / 0.28);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgb(124 58 237 / 0.1), transparent 48%),
      var(--bg-variation);
  }

  .featured-cs2 :global(.section-heading) {
    margin-bottom: 1.15rem;
  }

  .discover-card {
    min-width: 0;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
  }

  .discover-card h3 {
    margin: 0.35rem 0 0.5rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 800px) {
    .game-grid {
      grid-template-columns: 1.25fr 1fr;
      grid-template-rows: auto auto;
    }

    .game-grid > :global(:first-child) {
      grid-row: 1 / 3;
    }

    .feature-grid,
    .discover-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 799px) {
    .feature-grid,
    .discover-grid,
    .game-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

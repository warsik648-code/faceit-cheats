---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { blogPostingJsonLd, breadcrumbJsonLd } from '../../utils/jsonld';
import { blogBreadcrumb, homeBreadcrumb } from '../../utils/seo';
import {
  blogPath,
  blogSeoTitle,
  getPublishedPosts,
  getRelatedPosts,
  type BlogPost,
} from '../../utils/blog';
import { render } from 'astro:content';

interface Props {
  post: BlogPost;
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = await getPublishedPosts();
const related = getRelatedPosts(post, posts);
const { Content } = await render(post);
const path = blogPath(post);
const breadcrumbs = [homeBreadcrumb(), blogBreadcrumb(), { label: post.data.title, path }];
const seo = {
  path,
  title: blogSeoTitle(post),
  description: post.data.description,
};
---

<ArticleLayout
  seo={seo}
  breadcrumbs={breadcrumbs}
  extraJsonLd={[
    breadcrumbJsonLd(breadcrumbs),
    blogPostingJsonLd({
      title: post.data.title,
      description: post.data.description,
      path,
      datePublished: post.data.publishDate,
      dateModified: post.data.updatedDate,
      author: post.data.author,
      image: post.data.image,
    }),
  ]}
  post={post}
  related={related}
>
  <Content />
</ArticleLayout>
